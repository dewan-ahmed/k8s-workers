{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "deprecations",
  "main": "worker.ts",
  "compatibility_date": "2026-11-25",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "run_worker_first": ["/api/*"] },
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "SCAN_LIMIT", "namespace_id": "3116201", "simple": { "limit": 20, "period": 60 } },
    { "name": "EMAIL_LIMIT", "namespace_id": "3116202", "simple": { "limit": 3, "period": 60 } }
  ]
}
