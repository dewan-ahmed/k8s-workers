{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "compat",
  "main": "worker.ts",
  "compatibility_date": "2026-11-25",
  "workers_dev": true,
  "preview_urls": false,
  "assets": { "directory": "./public", "binding": "ASSETS", "run_worker_first": ["/", "/index.html", "/cartoon.css", "/api/*"] },
  "ratelimits": [
    { "name": "CHECK_LIMIT", "namespace_id": "3116203", "simple": { "limit": 20, "period": 60 } }
  ]
}
